---
interface Props {
    plate: "stack" | "ladder" | "dispose";
}

const { plate } = Astro.props;

const letter = "font-family: var(--font-mono); letter-spacing: 0.12em;";
const note = "font-family: var(--font-mono); letter-spacing: 0.04em;";

function along(x1: number, y1: number, x2: number, y2: number, n: number, r = 1.7) {
    return Array.from({ length: n }, (_, i) => {
        const t = (i + 0.5) / n;
        return {
            cx: +(x1 + (x2 - x1) * t).toFixed(1),
            cy: +(y1 + (y2 - y1) * t).toFixed(1),
            r,
        };
    });
}

function ring(cx: number, cy: number, radius: number, n: number, dot: number) {
    return Array.from({ length: n }, (_, i) => {
        const a = (Math.PI * 2 * i) / n - Math.PI / 2;
        return {
            cx: +(cx + Math.cos(a) * radius).toFixed(1),
            cy: +(cy + Math.sin(a) * radius).toFixed(1),
            r: dot,
        };
    });
}

const nearHoles = along(96, 302, 378, 322, 13, 1.8);
const farHoles = along(188, 176, 468, 160, 12, 1.6);
const leftHoles = along(92, 286, 168, 186, 5, 1.6);
const rightHoles = along(400, 316, 486, 168, 6, 1.6);
const bridgeHoles = along(214, 246, 308, 200, 5, 1.5);

const wheelL = ring(96, 368, 30, 8, 3.1);
const wheelR = ring(368, 382, 32, 8, 3.2);
const wheelDetail = ring(592, 286, 38, 6, 7);
---

