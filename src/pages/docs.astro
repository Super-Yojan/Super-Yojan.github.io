---
import DocPage from "../layouts/DocPage.astro";
import FleetDiagram from "../components/FleetDiagram.astro";
import { docSites } from "../data/docs";
---

<DocPage
    title="Documentation"
    description="ARGOS is the operator. Terra is the vehicle. Zorvane is the world. They meet on the terra/rover prefix."
    kicker="Guides"
    backHref="/"
    backLabel="Home"
>
    <p>
        The full manuals stay on their own sites. The pages in this section
        are the procedures you run first. Each one links to the manual and
        the repository it came from.
    </p>

    <FleetDiagram />

    {
        docSites.map((site) => (
            <section class="guide" id={site.slug}>
                <p class="t-label">{site.role}</p>
                <h2>{site.title}</h2>
                <p>{site.blurb}</p>
                <p class="guide-links">
                    {site.pages?.map((page) => (
                        <a class="link-wipe" href={page.href} aria-label={page.aria ?? page.label}>
                            {page.label}
                        </a>
                    ))}
                    <a class="link-wipe" href={site.docsUrl} aria-label={`${site.title} manual`}>
                        Manual
                    </a>
                    <a
                        class="link-wipe"
                        href={site.repoUrl}
                        target="_blank"
                        rel="noopener"
                        aria-label={`${site.title} on GitHub`}
                    >
                        GitHub
                    </a>
                </p>
            </section>
        ))
    }
</DocPage>

<style>
    .guide {
        margin-top: 48px;
        padding-top: 32px;
        border-top: 1px solid var(--rule);
        scroll-margin-top: 112px;
    }
    .guide :global(h2) {
        margin-top: 12px;
    }
    .guide-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 24px;
    }
</style>
