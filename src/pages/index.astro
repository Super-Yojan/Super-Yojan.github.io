---
import BaseLayout from "../layouts/BaseLayout.astro";
import Plate from "../components/Plate.astro";
import { projects } from "../data/projects";

/*
  DIRECTION CONTRACT — Landing (Experience)

  THESIS: A studio monograph for an engineer, printed in one ink. It refuses
  the dashboard-portfolio arrangement — stat tiles, status LEDs, terminal
  chrome — that this category always ships.

  OWN-WORLD: Paper white, ink black, three greys, no accent. Inter at two
  extremes: 12vw display against 14px tracked mono. Hairline 1px rules as the
  only divider. Project imagery is hand-drawn engineering plates, never
  photographs; the single exception is the frontispiece, which is footage held
  to the same ink by a CSS desaturation.

  STORY: A visitor lands inside a moving plate with a name across it, steps out
  onto paper, watches six drawn systems move past, reads one sentence
  explaining the span, then reaches the work. They leave knowing this person
  builds top to bottom.

  FIRST VIEWPORT: A full-bleed monochrome plate in pitch — a figure at the edge
  of a slow vortex — with the name centered over it at 12vw, letters rising
  into place; a 34ch sub-headline beneath in graphite inverse; a hairline rule
  at the fold carrying location and availability in mono. The plate ends on a
  hard edge and the paper resumes at the marquee.

  FORM: User-pinned brief (bold editorial studio) — no concept roll was run.
*/

const marqueeCards = [...projects, ...projects];
---

<BaseLayout>
    <section class="hero">
        <!-- The subject is centred and small, so the frame is allowed to be
             mostly empty. aria-hidden: it repeats nothing the copy states. -->
        <div class="hero-media" aria-hidden="true">
            <video
                id="hero-video"
                class="hero-video"
                poster="/media/hero-poster.jpg"
                autoplay
                muted
                loop
                playsinline
                preload="auto"
                tabindex="-1"
            >
                <source src="/media/hero-loop.mp4" type="video/mp4" />
            </video>
        </div>

        <!-- The fade-up carries the type off the footage and onto paper, so
             the two never fight for the same tone. -->
        <div class="hero-base">
            <div class="hero-base-inner">
                <div class="hero-lead">
                    <p class="hero-eyebrow">
                        <span class="hero-dot" aria-hidden="true"></span>
                        Masters in autonomous systems — GMU CIAO Lab
                    </p>

                    <h1 class="hero-heading">
                        Bare metal to<br />shipped software.
                    </h1>

                    <div class="hero-actions">
                        <a class="pill-btn pill-btn-dark" href="#work">See the work</a>
                        <a class="pill-btn pill-btn-ghost" href="/about">How I build</a>
                    </div>
                </div>

                <div class="hero-tags">
                    <span class="tag">Robotics</span>
                    <span class="tag">Embedded</span>
                    <span class="tag">Research</span>
                </div>
            </div>
        </div>
    </section>

    <section class="marquee" aria-label="Selected systems">
        <div class="marquee-track">
            {
                marqueeCards.map((p, i) => (
                    <a
                        class="marquee-card plate-host"
                        href={`/projects#${p.slug}`}
                        aria-hidden={i >= projects.length ? "true" : undefined}
                        tabindex={i >= projects.length ? -1 : undefined}
                    >
                        <div class="marquee-frame">
                            <div class="frame-head t-label">
                                <span>Fig. {p.index}</span>
                                <span>{p.category}</span>
                            </div>
                            <div class="plate">
                                <Plate plate={p.plate} />
                            </div>
                            <div class="frame-foot t-label">
                                {p.metrics[0].value} {p.metrics[0].label}
                            </div>
                        </div>
                        <div class="marquee-cap t-label">
                            <span>Fig. {p.index} — {p.title}</span>
                            <span>{p.year}</span>
                        </div>
                    </a>
                ))
            }
        </div>
    </section>

    <section class="statement shell">
        <p class="statement-lead rise">I build from the bare metal up.</p>
        <p class="statement-body rise" data-delay="120">
            Most of my projects start at the layer nobody wants to touch — a
            VHDL pipeline, a control loop, a quantized model small enough to run
            on a 150-gram airframe — and end at something a person can actually
            open and use. The span is the point.
        </p>
    </section>

    <section class="shell" id="work">
        <div class="section-head">
            <h2 class="t-headline">Selected work</h2>
            <span class="t-label">{projects.length} projects</span>
        </div>

        <div class="grid">
            {
                projects.map((p) => (
                    <a class="card plate-host rise" href={`/projects#${p.slug}`}>
                        <div class="card-frame">
                            <div class="plate">
                                <Plate plate={p.plate} />
                            </div>
                            <div class="card-veil" />
                            <span class="card-arrow" aria-hidden="true">
                                <svg
                                    viewBox="0 0 24 24"
                                    width="18"
                                    height="18"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                >
                                    <path d="M7 17 L17 7 M9 7 h8 v8" />
                                </svg>
                            </span>
                        </div>
                        <div class="card-meta">
                            <span class="t-label fig">Fig. {p.index}</span>
                            <h3 class="t-title card-name">{p.title}</h3>
                            <span class="t-label">{p.category}</span>
                            <span class="t-label">{p.year}</span>
                        </div>
                    </a>
                ))
            }
        </div>
    </section>

    <section class="shell close">
        <div class="close-rule">
            <span class="t-label">End of index</span>
        </div>
        <p class="close-lead rise">
            Building something at the edge of hardware and software?
        </p>
        <a class="close-link rise" data-delay="120" href="mailto:hi@super-yojan.dev">
            hi@super-yojan.dev
        </a>
    </section>
</BaseLayout>

<style>
    .close { padding-block: var(--section); }

    .close-rule {
        display: flex;
        justify-content: flex-end;
        padding-bottom: 24px;
        margin-bottom: 64px;
        border-bottom: 1px solid var(--ink);
    }

    .close-lead {
        max-width: 18ch;
        font-size: clamp(28px, 4.4vw, 60px);
        font-weight: 300;
        line-height: 1.05;
        letter-spacing: -0.04em;
        text-wrap: balance;
    }

    .close-link {
        display: inline-block;
        margin-top: 40px;
        font-size: clamp(1.5rem, 3.5vw, 3rem);
        font-weight: 300;
        letter-spacing: -0.04em;
        border-bottom: 1px solid var(--rule);
        transition: border-color var(--dur-state) var(--ease);
    }
    .close-link:hover { border-bottom-color: var(--ink); }
</style>

<script>
    // The plate plays only when it is both wanted and visible. CSS can hide a
    // video but cannot stop it decoding, so the pause has to happen here.
    const video = document.getElementById("hero-video") as HTMLVideoElement | null;

    if (video) {
        const calm = window.matchMedia("(prefers-reduced-motion: reduce)");

        const apply = () => {
            if (calm.matches) video.pause();
            else video.play().catch(() => {});
        };

        calm.addEventListener("change", apply);
        apply();

        // Scrolling past the fold leaves a decoder running behind six sections
        // of paper. Stop it, and pick it back up on the way home.
        const io = new IntersectionObserver(
            ([entry]) => {
                if (calm.matches) return;
                if (entry.isIntersecting) video.play().catch(() => {});
                else video.pause();
            },
            { threshold: 0 },
        );
        io.observe(video);
    }
</script>
