---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) =>
    date.toLocaleDateString("en-us", {
        month: "short",
        day: "2-digit",
        year: "numeric",
    });
---

<BaseLayout title="Writing" description="Engineering logs and research notes.">
    <header class="page-head shell">
        <h1 class="t-headline">
            <span class="reveal-line"><span>Writing</span></span>
        </h1>
        <p class="t-lede rise" data-delay="200">
            Engineering logs and research notes — worked examples rather than
            opinions, mostly from whatever I'm modeling that month.
        </p>
    </header>

    <section class="shell">
        {
            posts.length === 0 ? (
                <p class="empty t-lede">
                    Nothing published yet. The first log is in progress.
                </p>
            ) : (
                <div class="rows">
                    {posts.map((post) => (
                        <a href={`/blog/${post.id}/`} class="row rise">
                            <span class="t-label">
                                {formatDate(post.data.pubDate)}
                            </span>
                            <div>
                                <h2 class="t-title">{post.data.title}</h2>
                                <p class="row-note">{post.data.description}</p>
                            </div>
                            <span class="t-label read">Read →</span>
                        </a>
                    ))}
                </div>
            )
        }
    </section>
</BaseLayout>

<style>
    .row-note {
        max-width: 56ch;
        margin-top: 8px;
        color: var(--graphite);
    }
    .read {
        transition: color var(--dur-state) var(--ease);
    }
    .row:hover .read { color: var(--ink); }
    .empty { padding-block: 64px; border-top: 1px solid var(--rule); }
</style>
