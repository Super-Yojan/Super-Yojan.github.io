---
import BaseLayout from "../layouts/BaseLayout.astro";
import Plate from "../components/Plate.astro";
import { projects } from "../data/projects";
---

<BaseLayout
    title="Work"
    description="Selected work across robotics, embedded, consumer, and research."
>
    <header class="page-head shell">
        <h1 class="t-headline">
            <span class="reveal-line"><span>Work</span></span>
        </h1>
        <p class="t-lede rise" data-delay="200">
            Six systems, built end to end. Robotics, embedded, consumer, and
            research — the list is short because it only holds things I took
            all the way.
        </p>
    </header>

    <div class="shell entries">
        {
            projects.map((p) => (
                <article class="entry rise" id={p.slug}>
                    <div class="entry-plate">
                        <div class="card-frame">
                            {/* Detail surface: annotations stay up. */}
                            <div class="plate plate-static">
                                <Plate plate={p.plate} />
                            </div>
                        </div>
                        <p class="entry-cap t-label">
                            Fig. {p.index} — {p.blurb}
                        </p>
                    </div>

                    <div class="entry-body">
                        <div class="entry-top t-label">
                            <span>Fig. {p.index}</span>
                            <span>{p.category}</span>
                            <span>{p.year}</span>
                        </div>

                        <h2 class="entry-title">{p.title}</h2>
                        <p class="entry-detail">{p.detail}</p>

                        <dl class="specs">
                            {p.metrics.map((m) => (
                                <div class="spec">
                                    <dt class="spec-value">{m.value}</dt>
                                    <dd class="spec-label t-label">{m.label}</dd>
                                </div>
                            ))}
                        </dl>

                        <p class="entry-stack t-label">{p.stack.join(" · ")}</p>
                    </div>
                </article>
            ))
        }
    </div>
</BaseLayout>

<style>
    .entries {
        display: flex;
        flex-direction: column;
        gap: var(--section);
    }

    .entry {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 64px;
        align-items: center;
        scroll-margin-top: 120px;
    }
    .entry:nth-child(even) .entry-plate { order: 2; }

    .entry-top {
        display: flex;
        gap: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--rule);
    }

    .entry-title {
        margin-top: 24px;
        font-size: clamp(2rem, 4vw, 3.25rem);
        line-height: 1;
        letter-spacing: -0.05em;
    }

    .entry-detail {
        max-width: 52ch;
        margin-top: 24px;
        color: var(--graphite);
    }

    .specs {
        display: flex;
        flex-wrap: wrap;
        gap: 48px;
        margin: 40px 0 0;
        padding-top: 24px;
        border-top: 1px solid var(--rule);
    }
    .entry-cap {
        max-width: 46ch;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid var(--rule);
        text-transform: none;
        letter-spacing: 0.02em;
        line-height: 1.5;
    }

    .spec { margin: 0; }
    .spec-value {
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.03em;
        font-variant-numeric: tabular-nums slashed-zero;
    }
    .spec-label { margin: 6px 0 0; }

    .entry-stack { margin-top: 40px; }

    @media (max-width: 900px) {
        .entry { grid-template-columns: 1fr; gap: 32px; }
        .entry:nth-child(even) .entry-plate { order: 0; }
        .specs { gap: 32px; }
    }
</style>
