<figure class="fleet">
    <svg
        viewBox="0 0 820 420"
        role="img"
        aria-labelledby="fleet-title fleet-desc"
    >
        <title id="fleet-title">ARGOS, Zenoh, Zorvane, TerraPhone, and the Pi</title>
        <desc id="fleet-desc">
            ARGOS and the TerraPhone simulator reach Zorvane through Zenoh on
            terra/rover. A physical TerraPhone uses Bluetooth to the Pi.
        </desc>
        <defs>
            <marker
                id="fleet-arrow"
                viewBox="0 0 10 10"
                refX="8"
                refY="5"
                markerWidth="7"
                markerHeight="7"
                orient="auto-start-reverse"
            >
                <path
                    d="M1 1.5 L8 5 L1 8.5"
                    fill="none"
                    stroke="#000"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </marker>
        </defs>

        <rect class="zone" x="24" y="24" width="248" height="372" rx="8"></rect>
        <text class="eyebrow" x="148" y="48" text-anchor="middle">Apps</text>
        <rect class="zone" x="548" y="24" width="248" height="372" rx="8"></rect>
        <text class="eyebrow" x="672" y="48" text-anchor="middle">World and vehicle</text>

        <line class="edge" x1="244" y1="118" x2="304" y2="118" marker-end="url(#fleet-arrow)"></line>
        <line class="edge" x1="516" y1="118" x2="568" y2="118" marker-end="url(#fleet-arrow)"></line>
        <line class="edge" x1="244" y1="292" x2="568" y2="292" marker-end="url(#fleet-arrow)"></line>
        <path
            class="edge dashed"
            d="M144 214 V186 H402 Q410 186 410 178 V160"
            marker-end="url(#fleet-arrow)"></path>

        <text class="arrow-label" x="406" y="274" text-anchor="middle">Bluetooth</text>
        <text class="arrow-label" x="270" y="168" text-anchor="middle">Simulator</text>

        <g class="node">
            <rect x="40" y="76" width="204" height="84" rx="8"></rect>
            <text class="name" x="142" y="112" text-anchor="middle">ARGOS</text>
            <text class="sub" x="142" y="134" text-anchor="middle">Fleet operator</text>
        </g>
        <g class="node focal">
            <rect x="310" y="76" width="206" height="84" rx="8"></rect>
            <text class="name" x="413" y="104" text-anchor="middle">Zenoh</text>
            <text class="sub" x="413" y="124" text-anchor="middle">terra/rover</text>
            <text class="sub" x="413" y="142" text-anchor="middle">127.0.0.1:7447</text>
        </g>
        <g class="node">
            <rect x="572" y="76" width="200" height="84" rx="8"></rect>
            <text class="name" x="672" y="112" text-anchor="middle">Zorvane</text>
            <text class="sub" x="672" y="134" text-anchor="middle">World simulator</text>
        </g>
        <g class="node">
            <rect x="40" y="240" width="204" height="104" rx="8"></rect>
            <text class="name" x="142" y="282" text-anchor="middle">TerraPhone</text>
            <text class="sub" x="142" y="304" text-anchor="middle">Phone on the robot</text>
        </g>
        <g class="node">
            <rect x="572" y="240" width="200" height="104" rx="8"></rect>
            <text class="name" x="672" y="278" text-anchor="middle">Raspberry Pi</text>
            <text class="sub" x="672" y="300" text-anchor="middle">terra-rover</text>
            <text class="sub" x="672" y="318" text-anchor="middle">Fusion HAT</text>
        </g>
    </svg>
    <figcaption>
        ARGOS reaches Zorvane on <code>tcp/127.0.0.1:7447</code>, prefix
        <code>terra/rover</code>. A physical iPhone uses Bluetooth. The
        TerraPhone simulator build uses Zenoh instead.
    </figcaption>
</figure>

<style>
    .fleet {
        margin: 40px 0;
    }
    svg {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }
    .zone {
        fill: rgba(0, 0, 0, 0.02);
        stroke: rgba(0, 0, 0, 0.1);
        stroke-width: 1;
    }
    .eyebrow {
        fill: #525252;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }
    .edge {
        fill: none;
        stroke: #000;
        stroke-width: 1.25;
    }
    .dashed {
        stroke-dasharray: 4 3;
        stroke-width: 1;
    }
    .arrow-label {
        fill: #525252;
        font-family: var(--font-mono);
        font-size: 11px;
    }
    .node rect {
        fill: #fff;
        stroke: #000;
        stroke-width: 1;
    }
    .focal rect {
        stroke-width: 2;
    }
    .name {
        fill: #000;
        font-family: var(--font);
        font-size: 16px;
        font-weight: 500;
    }
    .sub {
        fill: #525252;
        font-family: var(--font);
        font-size: 13px;
        font-weight: 400;
    }
    figcaption {
        margin-top: 12px;
        color: var(--graphite);
        font-size: 15px;
        line-height: 1.5;
    }
    figcaption :global(code) {
        font-family: var(--font-mono);
        font-size: 0.85em;
    }
</style>
