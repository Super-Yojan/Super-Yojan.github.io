---
import "../styles/global.css";
import { SITE_TITLE } from "../consts";

const { title, description } = Astro.props as {
    title?: string;
    description?: string;
};

const fullTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const desc =
    description ??
    "Systems builder. Masters student in autonomous systems at GMU. Founder of Glid.";

const path = Astro.url.pathname;
const isActive = (href: string) =>
    href === "/"
        ? path === "/" || path === ""
        : path === href || path.startsWith(href + "/");

const routes = [
    { href: "/", label: "Index" },
    { href: "/projects", label: "Work" },
    { href: "/blog", label: "Writing" },
    { href: "/about", label: "About" },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <title>{fullTitle}</title>
        <meta name="description" content={desc} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={desc} />
        <meta property="og:type" content="website" />
        <script is:inline>
            // Reveals hide themselves only when JS can bring them back.
            document.documentElement.classList.add("js");
        </script>
    </head>
    <body>
        <div class="cursor" id="cursor" aria-hidden="true"></div>

        <a href="#main" class="skip-link">Skip to content</a>

        <!-- The bar itself is inert so the hero stays clickable underneath;
             only the controls take the pointer back. -->
        <header class="nav">
            <div class="nav-group">
                <a href="/" class="brand" aria-label="Yojan Gautam — home">
                    <svg
                        class="brand-mark"
                        viewBox="0 0 24 24"
                        width="24"
                        height="24"
                        aria-hidden="true"
                    >
                        <g transform="rotate(-35 12 12)">
                            <rect x="3.5" y="2" width="7" height="20" rx="3.5" />
                            <rect x="13.5" y="7" width="7" height="15" rx="3.5" />
                        </g>
                    </svg>
                    <span class="brand-name">Yojan Gautam</span>
                </a>

                <button
                    type="button"
                    class="pill pill-dark nav-toggle"
                    id="nav-toggle"
                    aria-expanded="false"
                    aria-controls="menu"
                >
                    <span class="knob knob-light" aria-hidden="true">
                        <svg
                            viewBox="0 0 24 24"
                            width="12"
                            height="12"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            stroke-linecap="round"
                        >
                            <path d="M12 5v14M5 12h14"></path>
                        </svg>
                    </span>
                    <span class="pill-text">Menu</span>
                </button>

                <div class="pill pill-soft nav-tags">
                    <span>Autonomous Systems</span>
                    <span>Embedded AI</span>
                </div>
            </div>

            <div class="nav-group">
                <div class="pill pill-soft nav-status">
                    <a
                        class="knob knob-dark"
                        href="/projects"
                        aria-label="Selected work"
                    >
                        <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
                            <circle cx="8" cy="8" r="2.1" />
                            <circle cx="16" cy="8" r="2.1" />
                            <circle cx="8" cy="16" r="2.1" />
                            <circle cx="16" cy="16" r="2.1" />
                        </svg>
                    </a>
                    <span class="nav-status-label">Open to collaboration</span>
                </div>
            </div>
        </header>

        <nav class="menu on-pitch" id="menu" aria-label="Main">
            {
                routes.map((r) => (
                    <a
                        href={r.href}
                        class="menu-link"
                        aria-current={isActive(r.href) ? "page" : undefined}
                    >
                        {r.label}
                    </a>
                ))
            }
            <div class="menu-meta t-label">
                <a href="mailto:hi@super-yojan.dev">hi@super-yojan.dev</a>
                <a href="https://github.com/Super-Yojan" target="_blank" rel="noopener">GitHub</a>
                <a href="https://linkedin.com/in/yojan-gautam/" target="_blank" rel="noopener">LinkedIn</a>
            </div>
        </nav>

        <main id="main">
            <slot />
        </main>

        <footer class="foot on-pitch">
            <div class="shell">
                <div class="foot-grid">
                    <div>
                        <p class="foot-brand">Yojan<br />Gautam</p>
                        <p class="foot-bio">
                            Systems builder working from analog circuits up to
                            shipped consumer software. Currently a Masters student
                            in autonomous systems at George Mason University's
                            CIAO Lab, and founder of Glid.
                        </p>
                    </div>

                    <div>
                        <h2 class="t-label">Socials</h2>
                        <div class="foot-list">
                            <a href="https://github.com/Super-Yojan" target="_blank" rel="noopener">GitHub</a>
                            <a href="https://linkedin.com/in/yojan-gautam/" target="_blank" rel="noopener">LinkedIn</a>
                            <a href="https://youtube.com/@Super-Yojan" target="_blank" rel="noopener">YouTube</a>
                        </div>
                    </div>

                    <div>
                        <h2 class="t-label">Contact</h2>
                        <div class="foot-list">
                            <a href="mailto:hi@super-yojan.dev">hi@super-yojan.dev</a>
                            <a href="/blog">Writing</a>
                            <a href="/rss.xml">RSS</a>
                        </div>
                    </div>
                </div>

                <div class="foot-bar">
                    <span>© {year} Yojan Gautam</span>
                    <span>Built with Astro · Washington, DC</span>
                </div>
            </div>
        </footer>

        <script>
            // ---- difference cursor -------------------------------------
            const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
            const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
            const cursor = document.getElementById("cursor");

            if (cursor && fine.matches) {
                let tx = window.innerWidth / 2;
                let ty = window.innerHeight / 2;
                let cx = tx;
                let cy = ty;
                let awake = false;

                window.addEventListener(
                    "pointermove",
                    (e) => {
                        tx = e.clientX;
                        ty = e.clientY;
                        if (!awake) {
                            awake = true;
                            cx = tx;
                            cy = ty;
                            cursor.classList.add("is-awake");
                        }
                    },
                    { passive: true },
                );

                document.addEventListener("pointerover", (e) => {
                    const el = e.target as Element | null;
                    cursor.classList.toggle(
                        "is-grown",
                        !!el?.closest?.('a, button, [role="button"], [data-cursor="grow"]'),
                    );
                });

                // pointerleave does not bubble, so this must sit on the root
                // element — on `document` it would never fire.
                document.documentElement.addEventListener("pointerleave", () =>
                    cursor.classList.remove("is-awake"),
                );

                // Lerp toward the pointer for the lagging feel; snap when the
                // visitor asked for reduced motion.
                const frame = () => {
                    const k = calm.matches ? 1 : 0.18;
                    cx += (tx - cx) * k;
                    cy += (ty - cy) * k;
                    cursor.style.translate = `${cx}px ${cy}px`;
                    requestAnimationFrame(frame);
                };
                requestAnimationFrame(frame);
            }

            // ---- the bar against pitch ----------------------------------
            // Two grounds can end up behind the fixed bar: the open menu, and
            // the footer sliding under it on a short viewport. Both would
            // swallow the ink wordmark and the ink pill, so the bar is told
            // when it is standing on pitch and flips its whole control set.
            const nav = document.querySelector(".nav");
            const pitch = document.querySelector(".foot");
            const panel = document.getElementById("menu");

            const syncNav = () => {
                if (!nav) return;
                // The bar's own band, not the whole viewport: the two only
                // clash where they actually overlap.
                const band = nav.getBoundingClientRect().bottom;
                const onPitch =
                    panel?.classList.contains("is-open") ||
                    (!!pitch && pitch.getBoundingClientRect().top < band);
                nav.classList.toggle("is-inverse", !!onPitch);
            };

            window.addEventListener("scroll", syncNav, { passive: true });
            window.addEventListener("resize", syncNav, { passive: true });
            syncNav();

            // ---- menu ---------------------------------------------------
            const toggle = document.getElementById("nav-toggle");
            const menu = document.getElementById("menu");

            if (toggle && menu) {
                const setOpen = (open: boolean) => {
                    menu.classList.toggle("is-open", open);
                    toggle.classList.toggle("is-open", open);
                    toggle.setAttribute("aria-expanded", String(open));
                    document.body.style.overflow = open ? "hidden" : "";
                    syncNav();
                };

                toggle.addEventListener("click", () =>
                    setOpen(!menu.classList.contains("is-open")),
                );
                document.addEventListener("keydown", (e) => {
                    if (e.key === "Escape" && menu.classList.contains("is-open")) {
                        setOpen(false);
                        toggle.focus();
                    }
                });
                menu.querySelectorAll("a").forEach((a) =>
                    a.addEventListener("click", () => setOpen(false)),
                );
            }

            // ---- reveals ------------------------------------------------
            const targets = document.querySelectorAll(".reveal-line, .rise");

            if (targets.length) {
                const io = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            const el = entry.target as HTMLElement;

                            // Anything already above the viewport must be shown
                            // outright, with no entrance. Otherwise an anchor
                            // jump (/projects#glid), a restored scroll position,
                            // or find-in-page leaves that content invisible
                            // forever, because it was never observed entering.
                            const passed = entry.boundingClientRect.bottom < 0;

                            if (!entry.isIntersecting && !passed) return;

                            const delay = passed
                                ? 0
                                : Number(el.dataset.delay ?? 0);
                            window.setTimeout(() => el.classList.add("is-in"), delay);
                            io.unobserve(el);
                        });
                    },
                    { rootMargin: "0px 0px -10% 0px" },
                );
                targets.forEach((t) => io.observe(t));
            }
        </script>
    </body>
</html>
