---
import BaseLayout from "./BaseLayout.astro";
import Plate from "../components/Plate.astro";
import type { PlateKey } from "../data/projects";

interface Link {
    href: string;
    label: string;
}

interface Props {
    title: string;
    description: string;
    lede: string;
    figureLabel: string;
    figureAlt: string;
    /** Real screenshot or poster. Omitted when the hero is a plate. */
    poster?: string;
    posterWidth?: number;
    posterHeight?: number;
    /** Engineering plate, used when the project has no photo and no model. */
    plate?: PlateKey;
    /** glTF URL. The viewer loads it lazily and keeps the poster otherwise. */
    model?: string;
    modelLabel?: string;
    /** Second caption, or the live/still note the viewer rewrites. */
    figureNote?: string;
    primary: Link;
    secondary?: Link;
    aboutTitle: string;
    sectionId: string;
    sectionTitle: string;
    sectionLede?: string;
    links?: Link[];
}

const {
    title,
    description,
    lede,
    figureLabel,
    figureAlt,
    poster,
    posterWidth = 1600,
    posterHeight = 1000,
    plate,
    model,
    modelLabel,
    figureNote,
    primary,
    secondary,
    aboutTitle,
    sectionId,
    sectionTitle,
    sectionLede,
    links = [],
} = Astro.props;
---

<BaseLayout title={title} description={description}>
    <header class="project-hero shell">
        <div class="hero-copy">
            <a href="/projects" class="link-wipe back">← Work</a>
            <h1 class="t-headline">
                <span class="reveal-line"><span>{title}</span></span>
            </h1>
            <p class="t-lede rise" data-delay="160">{lede}</p>
            <div class="hero-actions rise" data-delay="280">
                <a class="pill-btn pill-btn-dark" href={primary.href}>{primary.label}</a>
                {
                    secondary && (
                        <a class="pill-btn pill-btn-ghost" href={secondary.href}>
                            {secondary.label}
                        </a>
                    )
                }
            </div>
        </div>

        <figure
            class="stage rise"
            data-delay="160"
            data-model={model}
            data-model-label={modelLabel}
        >
            <div
                class:list={[
                    "stage-media",
                    plate && "is-plate",
                    poster && model && "is-model",
                    poster && !model && "is-photo",
                ]}
            >
                {
                    poster && (
                        <img
                            src={poster}
                            alt={figureAlt}
                            width={posterWidth}
                            height={posterHeight}
                        />
                    )
                }
                {
                    plate && (
                        <div class="plate plate-static">
                            <Plate plate={plate} />
                        </div>
                    )
                }
            </div>
            <figcaption class="stage-cap">
                <span class="visually-hidden">{figureLabel}. {figureAlt}</span>
                {
                    (model || figureNote) && (
                        <span class="orbit-hint t-label" data-note={model ? true : undefined}>{model ? "" : figureNote}</span>
                    )
                }
            </figcaption>
        </figure>
    </header>

    <section class="shell about">
        <h2 class="about-title">{aboutTitle}</h2>
        <div class="about-grid">
            <div class="prose">
                <slot name="prose" />
            </div>
            <dl class="facts">
                <slot name="facts" />
            </dl>
        </div>
    </section>

    <section class="shell quick" id={sectionId}>
        <div class="quick-head">
            <h2 class="about-title">{sectionTitle}</h2>
            {sectionLede && <p class="t-lede">{sectionLede}</p>}
        </div>
        <ol class="steps">
            <slot name="steps" />
        </ol>
        {
            links.length > 0 && (
                <p class="quick-foot">
                    {links.map((link) => (
                        <a class="link-wipe" href={link.href}>
                            {link.label}
                        </a>
                    ))}
                </p>
            )
        }
    </section>
</BaseLayout>

<style>
    .project-hero {
        display: grid;
        grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
        column-gap: clamp(24px, 4vw, 72px);
        align-items: stretch;
        min-height: 100svh;
        padding-top: 96px;
        padding-bottom: 40px;
    }
    .hero-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
    }
    .back { margin-bottom: 28px; }

    .project-hero :global(.t-lede) {
        max-width: 32ch;
        margin-top: 24px;
    }

    .stage {
        position: relative;
        margin: 0;
        min-width: 0;
        min-height: 0;
        height: 100%;
    }
    .stage-media {
        position: relative;
        height: 100%;
        min-height: 460px;
        border: 0;
        border-radius: 0;
        background: transparent;
        overflow: hidden;
    }
    /* Colour in a CAD render or a product screenshot stays out of the page. */
    .stage-media.is-model {
        filter: grayscale(1) contrast(1.18);
    }
    .stage-media.is-photo {
        filter: grayscale(1);
    }
    .stage-media img,
    .stage-media :global(canvas) {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }
    .stage-media img {
        object-fit: contain;
    }
    .stage-media.is-plate :global(.plate) {
        height: 100%;
    }
    .stage-media :global(canvas) {
        opacity: 0;
        background: transparent;
        touch-action: none;
    }
    .stage[data-state="live"] img {
        visibility: hidden;
    }
    .stage-media :global(canvas.is-shown) {
        opacity: 1;
        transition: opacity var(--dur-image) var(--ease);
    }
    .stage-cap {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 6px;
        margin: 0;
        padding: 0;
        border: 0;
        text-align: center;
        pointer-events: none;
    }
    .orbit-hint:empty { display: none; }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }

    .about {
        padding-bottom: var(--section);
    }
    .about-title {
        max-width: 16ch;
        font-size: clamp(28px, 4.4vw, 60px);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.05em;
    }
    .about-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(16rem, 0.8fr);
        gap: 64px;
        align-items: start;
        margin-top: 48px;
        min-width: 0;
    }
    .facts {
        margin: 0;
        border-top: 1px solid var(--rule);
    }
    .facts :global(div) {
        padding: 20px 0;
        border-bottom: 1px solid var(--rule);
    }
    .facts :global(dd) {
        margin: 8px 0 0;
    }
    .facts :global(code) {
        font-family: var(--font-mono);
        font-size: 0.9em;
    }
    .quick :global(.act) { font-weight: 500; }

    .quick {
        padding-bottom: var(--section);
        scroll-margin-top: 112px;
    }
    .quick-head :global(.t-lede) {
        max-width: 42ch;
        margin-top: 28px;
    }
    .steps {
        margin: 64px 0 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--rule);
    }
    .steps > :global(li) {
        display: grid;
        grid-template-columns: 6rem minmax(0, 1fr);
        gap: 32px;
        padding: 48px 0;
        border-bottom: 1px solid var(--rule);
        min-width: 0;
    }
    .steps :global(.prose),
    .steps :global(pre) {
        min-width: 0;
        max-width: 100%;
    }
    .steps :global(h3) { margin-top: 0; }
    .steps :global(.release-note) {
        max-width: 62ch;
        margin-top: 8px;
        padding-top: 20px;
        border-top: 1px solid var(--ink);
    }
    .steps :global(.release-note p:last-child) {
        margin-top: 12px;
        color: var(--graphite);
    }
    .quick-foot {
        display: flex;
        flex-wrap: wrap;
        gap: 16px 32px;
        margin-top: 48px;
    }

    @media (max-width: 900px) {
        .project-hero {
            grid-template-columns: 1fr;
            min-height: 0;
            padding-top: 112px;
            padding-bottom: 64px;
            row-gap: 12px;
        }
        .hero-copy { justify-content: flex-start; }
        .back { margin-bottom: 20px; }
        .stage { height: auto; }
        .stage-media {
            height: auto;
            min-height: 0;
            aspect-ratio: 1;
        }
        .about-grid { grid-template-columns: 1fr; gap: 40px; }
        .steps > :global(li) { grid-template-columns: 1fr; gap: 12px; }
    }
</style>
