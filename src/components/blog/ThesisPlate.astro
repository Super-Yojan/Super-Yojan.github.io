<style>
    .plate-fig {
        margin-block: 40px;
    }
    .plate-frame {
        overflow-x: auto;
        border: 1px solid #cfc6b8;
        border-radius: 2px;
        background: #fbf7f1;
        -webkit-overflow-scrolling: touch;
    }
    .plate-frame svg {
        display: block;
        width: 100%;
        min-width: 680px;
        height: auto;
    }
    figcaption {
        margin-top: 12px;
        color: var(--graphite);
        font-family: var(--font-mono);
        font-size: 14px;
        font-weight: 400;
        line-height: 1.45;
        letter-spacing: 0.01em;
    }
    .fig-num {
        display: block;
        margin-bottom: 4px;
        color: var(--safe-link);
        font-size: 14px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }
</style>
